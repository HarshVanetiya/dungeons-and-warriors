# Copy to apps/server/.env for local development. Never commit .env.
DATABASE_URL=postgresql://postgres@localhost:5432/dungeon_dev
# DIRECT_URL is only needed on Neon (non-pooled connection for migrations)
# DIRECT_URL=
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SOCKET_TOKEN_SECRET=change-me-to-another-long-random-string-32-chars
WEB_ORIGIN=http://localhost:3000
# log: codes are printed in the server log. resend: real emails (needs RESEND_API_KEY)
EMAIL_MODE=log
# RESEND_API_KEY=re_...
# EMAIL_FROM=Dungeon Drill <onboarding@resend.dev>
PORT=4000
